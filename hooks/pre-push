#!/bin/sh
#
# Opt-in pre-push hook for visie. Enable it with:
#
#     git config core.hooksPath ./hooks

set -u

# Redirect output to stderr.
exec 1>&2

if ! command -v uv >/dev/null 2>&1; then
  cat <<\EOF
Error: uv is not installed, so the tests cannot run.

Install uv from https://docs.astral.sh/uv/getting-started/installation/, then
run this from the root of the repo:

    uv sync
EOF
  exit 1
fi

echo "Running tests..."
if ! uv run pytest; then
  cat <<\EOF

Failed the tests. Fix them, then run:

    uv run pytest
EOF
  exit 1
fi
